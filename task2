from collections import defaultdict
import concurrent.futures
import re
import matplotlib.pyplot as plt
import requests


def get_text(url: str) -> str:
    """Завантажує текстові дані за вказаною URL-адресою."""
    try:
        response = requests.get(url, timeout=10)
        response.raise_for_status()
        return response.text
    except requests.RequestException as error:
        print(f"Помилка під час завантаження даних: {error}")
        return ""


def mapper(text_chunk: str) -> list[tuple[str, int]]:
    """Розбиває частину тексту на слова та повертає пари (слово, 1)."""
    words = re.findall(r"\b\w+\b", text_chunk.lower())
    return [(word, 1) for word in words]


def reducer(mapped_values: list[tuple[str, int]]) -> dict[str, int]:
    """Групує та підраховує сумарну частоту кожного слова (Shuffle & Reduce)."""
    word_counts = defaultdict(int)
    for word, count in mapped_values:
        word_counts[word] += count
    return dict(word_counts)


def map_reduce(text: str, chunk_size: int = 1000) -> dict[str, int]:
    """Виконує паралельну обробку тексту за парадигмою MapReduce."""
    lines = text.splitlines()
    chunks = [
        "\n".join(lines[i : i + chunk_size])
        for i in range(0, len(lines), chunk_size)
    ]

    mapped_results = []
    # Використання багатопотоковості для етапу Map
    with concurrent.futures.ThreadPoolExecutor() as executor:
        futures = [executor.submit(mapper, chunk) for chunk in chunks]
        for future in concurrent.futures.as_completed(futures):
            mapped_results.extend(future.result())

    # Етап Reduce
    return reducer(mapped_results)


def visualize_top_words(word_counts: dict[str, int], top_n: int = 10) -> None:
    """Візуалізує топ найчастіше вживаних слів у вигляді горизонтальної діаграми."""
    if not word_counts:
        print("Немає даних для візуалізації.")
        return

    # Сортування слів за спаданням частоти та вибірка топ-N
    sorted_words = sorted(
        word_counts.items(), key=lambda item: item[1], reverse=True
    )[:top_n]

    # Розгортаємо список для коректного відображення (найчастіше слово вгорі)
    sorted_words.reverse()
    words, counts = zip(*sorted_words)

    plt.figure(figsize=(10, 6))
    plt.barh(words, counts, color="#7ec8e8")
    plt.xlabel("Frequency")
    plt.ylabel("Words")
    plt.title(f"Top {top_n} Most Frequent Words")
    plt.tight_layout()
    plt.show()


if __name__ == "__main__":
    # Приклад: текст книги "A Tale of Two Cities" Чарльза Дікенса з проєкту Gutenberg
    url = "https://www.gutenberg.org/files/98/98-0.txt"

    print("Завантаження тексту...")
    text_data = get_text(url)

    if text_data:
        print("Обробка за допомогою MapReduce...")
        word_frequencies = map_reduce(text_data)

        print("Побудова графіка...")
        visualize_top_words(word_frequencies, top_n=10)
